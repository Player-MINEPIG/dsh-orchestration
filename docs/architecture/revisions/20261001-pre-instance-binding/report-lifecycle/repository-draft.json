  "cards": [
    {
      "dot": "cyan",
      "title": "追加而不抹除",
      "items": [
        "同正文但不同报告身份仍分别保存",
        "修订关联旧报告；工件保留版本或摘要"
      ]
    },
    {
      "dot": "amber",
      "title": "证据与执行权限不同",
      "items": [
        "迟到 / 失败 / 取消后的证据仍可留存",
        "追加报告不能绕过 lease 或改写权威终态"
      ]
    },
    {
      "dot": "emerald",
      "title": "来源清楚的同源查看",
      "items": [
        "dashboard 读取同一账本或明确导入快照",
        "来源时间与 stale 可见；快照不成为第二账本"
      ]
    }
  ]
