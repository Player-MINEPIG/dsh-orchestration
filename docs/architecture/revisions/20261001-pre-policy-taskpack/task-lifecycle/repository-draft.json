  "cards": [
    {
      "dot": "cyan",
      "title": "身份与执行所有权",
      "items": [
        "attempt 先原子绑定 executionId，再允许 agent / provider 执行副作用",
        "renew / bind / submit / cancel ACK 校验同一实例、节点与 fence"
      ]
    },
    {
      "dot": "amber",
      "title": "恢复与收束",
      "items": [
        "remote 日志持久化非秘密 instance UUID；同节点不同日志不能重复执行",
        "unknown / uncertain 必须复核；只重送已有结果，不重跑副作用",
        "success / partial 等待后代 allSettled quiet window；结果与送达分开"
      ]
    },
    {
      "dot": "emerald",
      "title": "定时也是自定义任务",
      "items": [
        "日报 / 游戏日报通过 Template + Schedule 配置",
        "每次 occurrence 保留日期和当时生效的配置",
        "autoExecute 可选且限制并发；观察收录不触发该执行路径"
      ]
    },
    {
      "dot": "slate",
      "title": "此图是设计约定",
      "items": [
