  "cards": [
    {
      "dot": "cyan",
      "title": "追加报告与排队备注",
      "items": [
        "同正文不同身份分别保存；修订关联旧报告；工件保留 digest / bytes",
        "note 先成为历史报告，再在下一 run 事务中进入 contextNotes；不授予新权限"
      ]
    },
    {
      "dot": "amber",
      "title": "预检、终态日志与权威收束",
      "items": [
        "native executor 预检 schema / 语义；task_settle 先暂存，idle 不等于任务成功",
        "静止终态写独立 FULL / WAL 日志；核心按同实例与本 run 后代最终复核",
        "任意迟到证据不能改写终态；可信日志恢复的是先前已就绪的精确结果"
      ]
    },
    {
      "dot": "emerald",
      "title": "维护中的 Task Pack 报告管线",
      "items": [
        "显式 source IDs → attempt-bound receipt → prepare；根日报另核 finalized artifact",
        "日报 / 游戏 / ad-hoc / diagnostics 的受信校验与来源范围不由模型注册",
        "schema Feishu renderer 只消费账本报告；read / prepare / settle / delivery 分离"
      ]
    },
    {
      "dot": "violet",
      "title": "投递与同源查询",
      "items": [
        "可选创建锚点与每 run 终态回复独立记录；未知外部送达不自动重复发信",
        "Alerts / approvals / health 与任务查询共用账本；quota 指标保留独立只读来源",
        "dashboard 显示 source / observedAt / stale，不维护第二本权威任务账本"
      ]
    },
    {
      "dot": "slate",
      "title": "此图不是实现验收",
      "items": [
        "图形表达批准设计与源码核实边界；运行验收以 PARITY.md 和实际测试回执为准",
        "当前没有 Git 对象来源证明、真实浏览器验收或生产外部连通声明"
      ]
    }
  ]
}
