{
  "name": "@dsh-task/feishu-channel",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Host-mounted Feishu chat and durable task delivery for DSH",
  "exports": {
    ".": "./dist/index.js",
    "./plugin": "./dist/dsh-plugin.js",
    "./dsh-chat": "./dist/dsh-chat.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "dsh.bundle.yml",
    "README.md",
    "dsh-chat.patch.example.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "dsh.bundle.yml"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.74.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@dsh-task/task-system": "0.1.0",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@dsh-task/task-system": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  }
}
