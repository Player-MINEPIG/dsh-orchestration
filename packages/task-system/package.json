{
  "name": "@dsh-task/task-system",
  "version": "0.2.55",
  "type": "module",
  "license": "MIT",
  "description": "Durable task management and authenticated multi-device execution inside DSH",
  "exports": {
    ".": "./dist/index.js",
    "./plugin": "./dist/dsh-plugin.js",
    "./local-codex": "./dist/local-codex.js",
    "./contracts": "./dist/contracts.js",
    "./planning": "./dist/planning.js",
    "./task-pack": "./dist/task-pack/index.mjs",
    "./task-pack/plugin": "./dist/task-pack/plugin.mjs",
    "./activity/plugin": "./dist/task-pack/activity/plugin.mjs",
    "./task-pack/readers": "./dist/task-pack/readers/index.mjs",
    "./task-pack/quota": "./dist/task-pack/quota/index.mjs",
    "./task-pack/quota/plugin": "./dist/task-pack/quota/plugin.mjs",
    "./task-pack/compatibility": "./dist/task-pack/compatibility/index.mjs",
    "./approval-bridge": "./dist/approval-bridge.js",
    "./task-policy": "./dist/task-policy.js",
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "default": "./dist/remote/index.js"
    },
    "./remote/api": {
      "types": "./dist/remote/api.d.ts",
      "default": "./dist/remote/api.js"
    },
    "./channels": "./dist/channels.js",
    "./client": "./dist/settings-client.js",
    "./project-registration": "./dist/project-registration/protocol.js",
    "./project-registration/plugin": "./dist/project-registration/plugin.js",
    "./project-registration/client": "./dist/project-registration/client.js",
    "./project-registration/http": "./dist/project-registration/http.js",
    "./workflows": "./dist/workflows.js",
    "./workflow-programs": "./dist/workflow-programs.js",
    "./session-titles": {
      "types": "./dist/session-titles.d.ts",
      "default": "./dist/session-titles.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "dsh.bundle.yml",
    "README.md",
    "remote.patch.yml",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "dsh.bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-typert-registry",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-permission-presets",
        "@deepseek-ai/dsh-client-ui-skill",
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-ui-user-questions"
      ]
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-task-pack.mjs && node ../../scripts/build-task-settings.mjs",
    "test": "node --test test/*.test.mjs test/remote/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent-codex": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "dsh-jev-plugin": "^0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "dsh-jev-plugin": "0.3.4"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "cron-parser": "5.4.0",
    "markdown-it": "15.0.2",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "dsh-jev-plugin": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent-codex": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  }
}
