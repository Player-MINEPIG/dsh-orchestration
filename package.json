{
  "name": "dsh-task-management",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH decisions and durable task/remote execution suite with optional channel adapters",
  "workspaces": [
    "packages/task-system",
    "packages/feishu-channel",
    "packages/jev",
    "dashboard"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build -w @dsh-task/task-system",
    "test": "npm run check",
    "check": "npm run build && npm run build:fixtures && npm run test:core && npm run test:native && npm run test:ui && npm run test:official && npm run test:jev && npm run test:dashboard && npm run test:task-pack && npm run test:management",
    "test:unit": "npm run build:fixtures && npm run test:core && npm run test:ui && npm run test:jev && npm run test:dashboard",
    "test:native": "node scripts/ci/task-tests.mjs native",
    "test:distribution": "node tests/dsh/distribution-acceptance.mjs && node tests/dsh/capability-distribution.mjs",
    "format:check": "prettier --check packages/task-system/src/*.ts",
    "test:legacy": "npm run test:task-pack",
    "test:legacy-reference": "node --test tests/legacy/differential-reference.test.mjs",
    "test:management": "node --test tests/management/*.test.mjs",
    "test:settings:official": "npm run test:official",
    "prototype:projects": "python3 -m http.server 8127 --bind 127.0.0.1 --directory dashboard/prototypes",
    "build:feishu": "npm run build -w @dsh-task/feishu-channel",
    "build:fixtures": "tsc -p packages/typed-decisions/tsconfig.json",
    "test:core": "node scripts/ci/task-tests.mjs core",
    "test:ui": "node scripts/ci/task-tests.mjs ui",
    "test:official": "node scripts/ci/task-tests.mjs official",
    "test:jev": "npm run test -w dsh-jev-plugin",
    "test:dashboard": "npm run test -w @dsh-orchestration/dashboard",
    "test:task-pack": "node --test tests/legacy/readers.test.mjs tests/legacy/reporting.test.mjs tests/legacy/quota.test.mjs tests/legacy/compatibility.test.mjs tests/legacy/configured-sources.test.mjs tests/legacy/ad-hoc.test.mjs tests/legacy/diagnostics.test.mjs tests/legacy/context-contract.test.mjs tests/legacy/activity.test.mjs tests/legacy/sra.test.mjs",
    "test:browser": "node tests/ci/browser.mjs",
    "setup:runtime": "node scripts/ci/runtime-install.mjs",
    "test:feishu": "npm run build:feishu && npm run test -w @dsh-task/feishu-channel",
    "test:distribution:feishu": "npm run build:feishu && node tests/dsh/capability-distribution.mjs --include-feishu"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent-codex": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.2",
    "@types/node": "24.10.1",
    "playwright": "1.58.2",
    "pnpm": "11.7.0",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  }
}
